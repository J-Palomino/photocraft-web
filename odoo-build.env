# Pinned inputs for the PhotoCraft web bundle shipped inside the Odoo module `mint_craft_office`
# (J-Palomino/odoo-custom-modules, bundles.txt). Bump these, push to `odoo-build`, and the workflow
# `.github/workflows/odoo-build.yml` publishes a release named RELEASE_TAG with the zip.
UPSTREAM_TAG=v0.16.0
# craft-fonts ref that upstream's own v0.16.0 release used (.github/workflows/release.yml).
CRAFT_FONTS_REF=abb83316d96aa59c1cf64784289e378fe9fa5695
PATCH=patches/v0.16.0/js-api.patch
RELEASE_TAG=odoo-v0.16.0-api.1
